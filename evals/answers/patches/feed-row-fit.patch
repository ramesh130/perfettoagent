+    BoxWithConstraints {
+        val fits = Constraints(maxWidth = constraints.maxWidth)
+        var size = TITLE_MIN_SP
+        while (size < TITLE_MAX_SP &&
+            !measurer.measure(post.title, style.copy(fontSize = (size + TITLE_STEP_SP).sp), maxLines = 3, constraints = fits)
+                .hasVisualOverflow
+        ) {
+            size += TITLE_STEP_SP
+        }
+        Text(
+            text = post.title,
+            style = style.copy(fontSize = size.sp),
+            maxLines = 3,
+            overflow = TextOverflow.Ellipsis,
+        )
+    }
+}
